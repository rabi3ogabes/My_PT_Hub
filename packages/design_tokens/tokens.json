{
  "$schema": "./tokens.schema.json",
  "name": "Aurum Design Tokens",
  "version": "1.0.0",
  "color": {
    "brand": {
      "gold": "#D4AF6A",
      "goldLight": "#E8CF9B",
      "goldDark": "#A9853F",
      "onGold": "#0B0B0F"
    },
    "dark": {
      "background": "#0B0B0F",
      "surface": "#16161D",
      "surfaceRaised": "#1E1E27",
      "surfaceSunken": "#101015",
      "border": "#2A2A35",
      "borderStrong": "#3A3A48",
      "textPrimary": "#F5F3EE",
      "textSecondary": "#B4B1AA",
      "textMuted": "#7D7A74",
      "overlay": "#000000B3"
    },
    "light": {
      "background": "#FAF8F4",
      "surface": "#FFFFFF",
      "surfaceRaised": "#FFFFFF",
      "surfaceSunken": "#F2EFE8",
      "border": "#E7E2D8",
      "borderStrong": "#D2CBBD",
      "textPrimary": "#121217",
      "textSecondary": "#4B4A52",
      "textMuted": "#86848C",
      "overlay": "#0B0B0F80"
    },
    "semantic": {
      "success": "#3DBE8B",
      "successSoft": "#3DBE8B1F",
      "warning": "#F2B544",
      "warningSoft": "#F2B5441F",
      "danger": "#EF5A5A",
      "dangerSoft": "#EF5A5A1F",
      "info": "#5B8DEF",
      "infoSoft": "#5B8DEF1F"
    },
    "macro": {
      "protein": "#E76F6F",
      "carbs": "#D4AF6A",
      "fat": "#6FA8E7",
      "kcal": "#3DBE8B"
    }
  },
  "font": {
    "latin": "Manrope",
    "arabic": "IBM Plex Sans Arabic",
    "mono": "JetBrains Mono"
  },
  "typography": {
    "display": { "size": 48, "lineHeight": 1.05, "weight": 800, "tracking": -0.03 },
    "h1": { "size": 36, "lineHeight": 1.1, "weight": 800, "tracking": -0.025 },
    "h2": { "size": 28, "lineHeight": 1.15, "weight": 700, "tracking": -0.02 },
    "h3": { "size": 22, "lineHeight": 1.2, "weight": 700, "tracking": -0.015 },
    "title": { "size": 18, "lineHeight": 1.3, "weight": 600, "tracking": -0.01 },
    "body": { "size": 16, "lineHeight": 1.5, "weight": 400, "tracking": 0 },
    "bodySmall": { "size": 14, "lineHeight": 1.45, "weight": 400, "tracking": 0 },
    "label": { "size": 13, "lineHeight": 1.3, "weight": 600, "tracking": 0.01 },
    "caption": { "size": 12, "lineHeight": 1.3, "weight": 500, "tracking": 0.02 },
    "overline": { "size": 11, "lineHeight": 1.2, "weight": 700, "tracking": 0.12 }
  },
  "spacing": { "0": 0, "1": 4, "2": 8, "3": 12, "4": 16, "5": 20, "6": 24, "8": 32, "10": 40, "12": 48, "16": 64, "20": 80 },
  "radius": { "xs": 6, "sm": 10, "md": 14, "lg": 20, "xl": 28, "pill": 999 },
  "elevation": {
    "1": "0 1px 2px rgba(11,11,15,0.06), 0 1px 3px rgba(11,11,15,0.08)",
    "2": "0 4px 12px rgba(11,11,15,0.08), 0 2px 4px rgba(11,11,15,0.06)",
    "3": "0 12px 32px rgba(11,11,15,0.14), 0 4px 8px rgba(11,11,15,0.08)",
    "glow": "0 0 0 1px rgba(212,175,106,0.35), 0 8px 30px rgba(212,175,106,0.18)"
  },
  "motion": {
    "fast": 150,
    "base": 220,
    "slow": 300,
    "easeOut": [0.16, 1, 0.3, 1],
    "easeInOut": [0.65, 0, 0.35, 1]
  },
  "touchTarget": 44
}
