(aurum_upstream) {
	# active_upstream.caddy contains a single line: `reverse_proxy web-blue:80` or `web-green:80`.
	# deploy.sh rewrites it and runs `caddy reload` — in-flight requests finish on the old colour.
	import /etc/caddy/active_upstream.caddy
}

{$AURUM_DOMAINS:aurum.coach, www.aurum.coach, api.aurum.coach, *.app.aurum.coach} {
	encode zstd gzip
	header -Server
	import aurum_upstream
}
