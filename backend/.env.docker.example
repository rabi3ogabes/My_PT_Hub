# Aurum — environment for the local docker compose stack.
#   cp backend/.env.docker.example backend/.env && make install
# Every value here is a LOCAL default. Production secrets live in the secret
# manager / GitHub environments, never in the repository.

APP_NAME=Aurum
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

BRAND_NAME=Aurum
BRAND_TAGLINE="The coaching platform for professionals"
BRAND_ACCENT=#D4AF6A
BRAND_DOMAIN=aurum.coach
BRAND_SUPPORT_EMAIL=support@aurum.coach
ANDROID_PACKAGE=coach.aurum.client
ANDROID_COACH_PACKAGE=coach.aurum.coach
IOS_APP_ID=
IOS_COACH_APP_ID=
APPLE_TEAM_ID=
ANDROID_SHA256_FINGERPRINTS=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug
LOG_DEPRECATIONS_CHANNEL=null

# --- Database (postgres:16 service) ---------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=aurum
DB_USERNAME=aurum
DB_PASSWORD=aurum
DB_SSLMODE=disable

# --- Redis (cache, sessions, queues, Horizon, Reverb scaling) -------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
QUEUE_CONNECTION=redis
HORIZON_PATH=horizon

# --- Realtime (reverb service) --------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=aurum-local
REVERB_APP_KEY=aurum-local-key
REVERB_APP_SECRET=aurum-local-secret
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
# Where browsers / apps connect (nginx proxies /app to reverb as well).
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
VITE_APP_NAME="${APP_NAME}"

# --- Mail (mailpit service — UI at http://localhost:8025) -----------------
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_SCHEME=null
MAIL_FROM_ADDRESS="hello@aurum.coach"
MAIL_FROM_NAME="${APP_NAME}"

# --- Storage ---------------------------------------------------------------
# Local disk works out of the box. To exercise the S3 code path against MinIO,
# install league/flysystem-aws-s3-v3 and set FILESYSTEM_DISK=s3.
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=aurum
AWS_SECRET_ACCESS_KEY=aurum-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=aurum-private
AWS_PUBLIC_BUCKET=aurum-media
AWS_ENDPOINT=http://minio:9000
AWS_URL=http://localhost:9000/aurum-media
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Search (meilisearch service) -----------------------------------------
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=aurum-meili-master-key-local

# --- Media pipeline --------------------------------------------------------
FFMPEG_BINARY=/usr/bin/ffmpeg
FFPROBE_BINARY=/usr/bin/ffprobe
VIDEO_DRIVER=ffmpeg

# --- AI (Fake provider by default: deterministic, no network) -------------
AI_DRIVER=fake
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_VISION_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AI_TENANT_MONTHLY_CAP_MICROS=50000000

# --- SaaS billing (Stripe test mode; leave empty to use the local gateway) -
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_ANNUAL=

# --- Social sign-in ----------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_REDIRECT_URI=/auth/google/callback
APPLE_CLIENT_ID=
APPLE_BUNDLE_IDS=coach.aurum.client,coach.aurum.coach

# --- Push (Firebase service account JSON path or base64) ------------------
FIREBASE_CREDENTIALS=

# --- Integrations (optional locally) --------------------------------------
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
OFF_BASE_URL=https://world.openfoodfacts.org

# --- Observability -----------------------------------------------------------
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- Seeding -----------------------------------------------------------------
# DemoSeeder creates clearly-flagged demo coaches/clients. Never true in production.
SEED_DEMO=true
